# ── Phase 2: Theme Grouping ───────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here          # https://console.groq.com

# ── Phase 3: Note Generation ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here      # https://aistudio.google.com

# ── Phase 4: Email Draft ──────────────────────────────────────────────────────
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx       # Gmail App Password (not your login password)
EMAIL_RECIPIENT=team@yourcompany.com

# ── Scheduler (GitHub Actions weekly trigger) ─────────────────────────────────
SCHEDULER_RECIPIENT_EMAIL=team@yourcompany.com   # who receives the automatic weekly email
SCHEDULER_RECIPIENT_NAME=Product Team            # display name (optional)
SCHEDULER_WEEKS=3                                # lookback window (default: 3)
SCHEDULER_MAX_REVIEWS=200                        # max reviews per run (default: 200)
